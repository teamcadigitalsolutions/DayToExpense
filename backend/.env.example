# DayToExpense Backend Environment Configuration Example
APP_NAME=DayToExpense
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1

DATABASE_URL=mysql+aiomysql://admin:admin@127.0.0.1:3307/daytodayexpenses

LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3307
LEGACY_DB_NAME=daytodayexpenses
LEGACY_DB_USER=admin
LEGACY_DB_PASSWORD=admin

JWT_SECRET_KEY=change-this-secret-key-in-production-1234567890
JWT_REFRESH_SECRET_KEY=change-this-refresh-secret-key-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
