# DayToExpense — Environment Configuration
APP_NAME=DayToExpense
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1

# ─── PostgreSQL Database ─────────────────────────────────────────────────────
# Host: 46.250.239.148 | Port: 5432 | DB: sample_db
# User: abhishek_user | Password: abhishek_user
# Note: Port 5143 is not TCP-reachable externally; PostgreSQL listens on 5432.
# DATABASE_URL=postgresql://daytodayexpenses:daytodayexpenses@46.250.239.148:5432/daytodayexpenses_db # online db
 DATABASE_URL=mysql+aiomysql://admin:admin%40123@127.0.0.1:3307/daytodayexpenses # local mysql db

# ─── JWT Authentication ──────────────────────────────────────────────────────
JWT_SECRET_KEY=daytoexpense-dev-secret-key-change-in-production-1234567890
JWT_REFRESH_SECRET_KEY=daytoexpense-dev-refresh-secret-key-change-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://daytoexpense.onrender.com

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,pdf,xlsx,csv

# ─── Application Defaults ────────────────────────────────────────────────────
BASE_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_DATE_FORMAT=DD/MM/YYYY

# ─── Legacy DB Settings (mirrors DATABASE_URL) ────────────────────────────────
LEGACY_DB_HOST=46.250.239.148
LEGACY_DB_PORT=5432
LEGACY_DB_NAME=sample_db
LEGACY_DB_USER=abhishek_user
LEGACY_DB_PASSWORD=abhishek_user
