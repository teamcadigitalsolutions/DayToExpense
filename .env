# DayToExpense Environment Configuration
APP_NAME=DayToExpense
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1

# MySQL Workbench Database Connection
# Connection: Server=127.0.0.1; Port=3307; Database=daytodayexpenses; Uid=admin; Pwd=admin@123
DATABASE_URL=mysql+pymysql://admin:admin%40123@127.0.0.1:3307/daytodayexpenses

# Legacy MySQL Settings
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3307
LEGACY_DB_NAME=daytodayexpenses
LEGACY_DB_USER=admin
LEGACY_DB_PASSWORD=admin@123

# JWT Authentication
JWT_SECRET_KEY=daytoexpense-dev-secret-key-change-in-production-1234567890
JWT_REFRESH_SECRET_KEY=daytoexpense-dev-refresh-secret-key-change-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
